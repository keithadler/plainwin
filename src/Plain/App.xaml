<Application x:Class="Plain.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <!-- Light is the default set; App.xaml.cs swaps these when Windows is set to dark. -->
    <SolidColorBrush x:Key="Chrome"        Color="#F6F5F2"/>
    <SolidColorBrush x:Key="Chrome2"       Color="#EAE8E2"/>
    <SolidColorBrush x:Key="Surface"       Color="#FDFDFB"/>
    <SolidColorBrush x:Key="Surface2"      Color="#F2F1ED"/>
    <SolidColorBrush x:Key="Line"          Color="#DEDCD5"/>
    <SolidColorBrush x:Key="LineStrong"    Color="#C7C4BA"/>
    <SolidColorBrush x:Key="Ink"           Color="#1B1A17"/>
    <SolidColorBrush x:Key="Ink2"          Color="#5E5C53"/>
    <SolidColorBrush x:Key="Ink3"          Color="#8D8A7F"/>
    <SolidColorBrush x:Key="Accent"        Color="#1F6FB2"/>
    <SolidColorBrush x:Key="AccentInk"     Color="#145084"/>
    <SolidColorBrush x:Key="AccentSoft"    Color="#E2EDF7"/>
    <SolidColorBrush x:Key="Preserved"     Color="#9A6B15"/>
    <SolidColorBrush x:Key="PreservedSoft" Color="#F7EFDC"/>
    <SolidColorBrush x:Key="PreservedLine" Color="#E3D3AE"/>

    <Style TargetType="Button" x:Key="Flat">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="9,0"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface2}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
