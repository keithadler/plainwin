<Application x:Class="Plain.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <!-- Light is the default set; App.xaml.cs swaps these when Windows is set to dark. -->
    <SolidColorBrush x:Key="Chrome"        Color="#F6F5F2"/>
    <SolidColorBrush x:Key="Chrome2"       Color="#EAE8E2"/>
    <SolidColorBrush x:Key="Surface"       Color="#FDFDFB"/>
    <SolidColorBrush x:Key="Surface2"      Color="#F2F1ED"/>
    <SolidColorBrush x:Key="Line"          Color="#DEDCD5"/>
    <SolidColorBrush x:Key="LineStrong"    Color="#C7C4BA"/>
    <SolidColorBrush x:Key="Ink"           Color="#1B1A17"/>
    <SolidColorBrush x:Key="Ink2"          Color="#5E5C53"/>
    <SolidColorBrush x:Key="Ink3"          Color="#8D8A7F"/>
    <SolidColorBrush x:Key="Accent"        Color="#1F6FB2"/>
    <SolidColorBrush x:Key="AccentInk"     Color="#145084"/>
    <SolidColorBrush x:Key="AccentSoft"    Color="#E2EDF7"/>
    <SolidColorBrush x:Key="Preserved"     Color="#9A6B15"/>
    <SolidColorBrush x:Key="PreservedSoft" Color="#F7EFDC"/>
    <SolidColorBrush x:Key="PreservedLine" Color="#E3D3AE"/>

    <!-- WPF's own scroll bars are painted from system colours and stay light in a dark window. -->
    <Style TargetType="Thumb" x:Key="ScrollThumb">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="t" Background="{DynamicResource LineStrong}" CornerRadius="4" Margin="3"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="t" Property="Background" Value="{DynamicResource Ink3}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="RepeatButton" x:Key="ScrollLine">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="{DynamicResource Surface2}"/>
      <Setter Property="Width" Value="13"/>
      <Setter Property="MinWidth" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollLine}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollLine}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="13"/>
                <Setter Property="MinHeight" Value="13"/>
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Flat">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="9,0"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinWidth" Value="28"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface2}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Ink3}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
