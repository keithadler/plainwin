<Window x:Class="Plain.ReadingSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reading" SizeToContent="Height" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Chrome}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
  <StackPanel Margin="20">
    <TextBlock Text="How text looks while you read and write it. These change nothing in your files."
               TextWrapping="Wrap" Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,0,16"/>

    <TextBlock Text="Typeface" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <ComboBox x:Name="FontPicker" Height="28" VerticalContentAlignment="Center"/>
    <TextBlock Text="Anything installed on this PC. A face made for easier reading, if you have one, belongs here."
               TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Ink3}" Margin="0,4,0,14"/>

    <TextBlock Text="Paper" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <ComboBox x:Name="PaperPicker" Height="28" VerticalContentAlignment="Center"/>
    <TextBlock Text="Black on white glares for some people. A tinted paper is not the same as dark mode."
               TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Ink3}" Margin="0,4,0,14"/>

    <TextBlock Text="Line spacing" FontWeight="SemiBold" Margin="0,0,0,4"/>
    <ComboBox x:Name="SpacingPicker" Height="28" VerticalContentAlignment="Center"/>

    <TextBlock Text="How wide the text may get" FontWeight="SemiBold" Margin="0,14,0,4"/>
    <DockPanel>
      <TextBlock x:Name="WidthLabel" DockPanel.Dock="Right" Width="86" TextAlignment="Right"
                 Foreground="{DynamicResource Ink2}" FontSize="12"/>
      <Slider x:Name="WidthSlider" Minimum="380" Maximum="1200" TickFrequency="20" IsSnapToTickEnabled="True"
              ValueChanged="OnWidthChanged" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock Text="A shorter line is easier to come back to when your eye leaves the page."
               TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Ink3}" Margin="0,4,0,14"/>

    <CheckBox x:Name="KeepRecovery" Content="Keep a copy of unsaved work in case this machine stops"
              Margin="0,0,0,4"/>
    <TextBlock Text="A copy is kept every half minute beside the settings, and offered back next time Plain starts."
               TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Ink3}" Margin="22,0,0,18"/>

    <TextBlock Text="Printing and PDF" FontWeight="SemiBold" Margin="0,4,0,6"/>
    <DockPanel Margin="0,0,0,8" LastChildFill="False">
      <TextBlock Text="Paper" VerticalAlignment="Center" Width="70" Foreground="{DynamicResource Ink2}"/>
      <ComboBox x:Name="PaperBox" Width="120" DockPanel.Dock="Left"/>
      <CheckBox x:Name="LandscapeBox" Content="Sideways" VerticalAlignment="Center" Margin="16,0,0,0" DockPanel.Dock="Left"/>
    </DockPanel>
    <DockPanel Margin="0,0,0,8" LastChildFill="False">
      <TextBlock Text="Edges" VerticalAlignment="Center" Width="70" Foreground="{DynamicResource Ink2}"/>
      <ComboBox x:Name="MarginBox" Width="120" DockPanel.Dock="Left"/>
    </DockPanel>
    <DockPanel Margin="0,0,0,8" LastChildFill="True">
      <TextBlock Text="Top line" VerticalAlignment="Center" Width="70" Foreground="{DynamicResource Ink2}"/>
      <TextBox x:Name="HeaderBox" Padding="4,3"/>
    </DockPanel>
    <DockPanel Margin="0,0,0,4" LastChildFill="True">
      <TextBlock Text="Bottom line" VerticalAlignment="Center" Width="70" Foreground="{DynamicResource Ink2}"/>
      <TextBox x:Name="FooterBox" Padding="4,3"/>
    </DockPanel>
    <TextBlock Text="{}{page} and {pages} are filled in. Plain lays the text out on its own page: it does not know where Word would break one, and does not pretend to."
               TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Ink3}" Margin="70,0,0,18"/>

    <CheckBox x:Name="CheckUpdates" Content="Check GitHub once a day for a new version"
              Margin="0,0,0,4"/>
    <TextBlock Text="The only thing Plain ever sends over a network. It sends nothing about you or your files, downloads nothing, and installs nothing: it puts a line in the status bar and you decide. Turn this off and Plain makes no network request at all."
               TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Ink3}" Margin="22,0,0,18"/>

    <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="6" Padding="14"
            Background="{DynamicResource Surface}" Margin="0,0,0,18">
      <TextBlock x:Name="Sample" TextWrapping="Wrap"
                 Text="The quick brown fox jumps over the lazy dog. Handling of the pale, quiet page is what most of reading is."/>
    </Border>

    <DockPanel>
      <Button Content="Cancel" IsCancel="True" DockPanel.Dock="Right" Height="30" Width="90" Margin="8,0,0,0"/>
      <Button Content="Save" IsDefault="True" Click="OnSave" DockPanel.Dock="Right" Height="30" Width="90"/>
      <Button Content="Back to normal" Click="OnReset" HorizontalAlignment="Left" Height="30" Width="130"/>
    </DockPanel>
  </StackPanel>
</Window>
