<Window x:Class="Plain.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plain" Height="720" Width="1180" MinHeight="420" MinWidth="720"
        Background="{DynamicResource Chrome}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- open files -->
    <Border Grid.Row="0" Background="{DynamicResource Chrome}" Padding="8,4,8,0">
      <ItemsControl x:Name="Tabs">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Border>

    <!-- one command row -->
    <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="8,5">
      <DockPanel LastChildFill="False">
        <Button x:Name="MoreBtn" Style="{StaticResource Flat}" Content="More" Click="OnMore"
                DockPanel.Dock="Right" Margin="6,0,0,0">
          <Button.ContextMenu>
            <ContextMenu x:Name="MoreMenu">
              <MenuItem Header="Print…" Click="OnPrint" InputGestureText="Ctrl+P"/>
              <MenuItem Header="Save as PDF…" Click="OnPdf"/>
              <Separator/>
              <MenuItem Header="Reading…" Click="OnSettings"/>
              <Separator/>
              <MenuItem x:Name="AboutItem" Header="About Plain" Click="OnAbout"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button x:Name="KeepBtn" Style="{StaticResource Flat}" Click="OnToggleRail" DockPanel.Dock="Right"
                Background="{DynamicResource PreservedSoft}" BorderBrush="{DynamicResource PreservedLine}"
                Foreground="{DynamicResource Preserved}" FontWeight="SemiBold" Content="Preserved"/>
        <Button x:Name="NewBtn" Style="{StaticResource Flat}" Content="New" Click="OnNew" DockPanel.Dock="Left">
          <Button.ContextMenu>
            <ContextMenu x:Name="NewMenu">
              <MenuItem Header="Spreadsheet  (.xlsx)" Click="OnNewSheet"/>
              <MenuItem Header="Document  (.docx)" Click="OnNewDoc"/>
              <MenuItem Header="Presentation  (.pptx)" Click="OnNewDeck"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button x:Name="OpenBtn" Style="{StaticResource Flat}" Content="Open" Click="OnOpen" DockPanel.Dock="Left" Margin="2,0,0,0"/>
        <Button x:Name="SaveBtn" Style="{StaticResource Flat}" Content="Save" Click="OnSave" DockPanel.Dock="Left" Margin="2,0,0,0"/>
        <Button x:Name="CopyBtn" Style="{StaticResource Flat}" Content="Save a copy" Click="OnSaveCopy" DockPanel.Dock="Left" Margin="2,0,0,0"/>
        <Button x:Name="UndoBtn" Style="{StaticResource Flat}" Content="Undo" Click="OnUndo" DockPanel.Dock="Left" Margin="2,0,0,0"/>
        <Border x:Name="Sep1" Width="1" Background="{DynamicResource Line}" Height="18" Margin="8,0" DockPanel.Dock="Left"/>
        <Button x:Name="BoldBtn" Style="{StaticResource Flat}" Content="B" FontWeight="Bold" Width="30"
                Click="OnBold" DockPanel.Dock="Left" Visibility="Collapsed" ToolTip="Bold (Ctrl+B)"/>
        <Button x:Name="ItalicBtn" Style="{StaticResource Flat}" Content="I" FontStyle="Italic" Width="30"
                FontFamily="Georgia" Click="OnItalic" DockPanel.Dock="Left" Margin="2,0,6,0"
                Visibility="Collapsed" ToolTip="Italic (Ctrl+I)"/>
        <ComboBox x:Name="StylePicker" DockPanel.Dock="Left" Width="128" Height="26" Margin="0,0,6,0"
                  VerticalContentAlignment="Center" FontSize="12.5" Visibility="Collapsed"
                  SelectionChanged="OnStylePicked" ToolTip="What kind of block this is"/>
        <ComboBox x:Name="FormatPicker" DockPanel.Dock="Left" Width="132" Height="26" Margin="0,0,6,0"
                  VerticalContentAlignment="Center" FontSize="12.5" Visibility="Collapsed"
                  SelectionChanged="OnFormatPicked" ToolTip="How the selected cells show their number"/>
        <Button x:Name="BulletBtn" Style="{StaticResource Flat}" Content="&#8226;" Width="30" Click="OnBullet"
                DockPanel.Dock="Left" Visibility="Collapsed" ToolTip="Bulleted list"/>
        <Button x:Name="NumberBtn" Style="{StaticResource Flat}" Content="1." Width="30" Click="OnNumberList"
                DockPanel.Dock="Left" Margin="2,0,6,0" Visibility="Collapsed" ToolTip="Numbered list"/>
        <Button x:Name="NotesBtn" Style="{StaticResource Flat}" Content="Comments" Click="OnToggleNotes"
                DockPanel.Dock="Left" Visibility="Collapsed"/>
        <Button x:Name="PicturesBtn" Style="{StaticResource Flat}" Content="Pictures" Click="OnTogglePictures"
                DockPanel.Dock="Left" Margin="2,0,0,0" Visibility="Collapsed"/>

        <TextBlock x:Name="ContextHint" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="4,0,10,0"
                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ink3}" FontSize="12"/>
      </DockPanel>
    </Border>

    <!-- formula bar, spreadsheets only -->
    <Border x:Name="FormulaBar" Grid.Row="2" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Visibility="Collapsed">
      <Grid Height="30">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="96"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="CellRefText" Grid.Column="0" VerticalAlignment="Center" Margin="10,0"
                   FontFamily="Cascadia Mono, Consolas" FontSize="12.5"/>
        <Border Grid.Column="1" Width="1" Background="{DynamicResource Line}"/>
        <TextBox x:Name="CellEditor" Grid.Column="2" VerticalAlignment="Center" Margin="10,0" Padding="0,3"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5" BorderThickness="0"
                 Background="Transparent" Foreground="{DynamicResource Ink}"
                 KeyDown="OnFormulaKey" LostFocus="OnFormulaCommit"/>
      </Grid>
    </Border>

    <!-- the file, and the list of what Plain is keeping -->
    <Grid Grid.Row="3" Background="{DynamicResource Surface}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <ContentControl x:Name="Stage" Grid.Column="0"/>

      <StackPanel x:Name="Welcome" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
        <TextBlock TextAlignment="Center" Foreground="{DynamicResource Ink3}" FontSize="14" LineHeight="24"
                   TextWrapping="Wrap"
                   Text="Open a Word, Excel or PowerPoint file, or drop one here.&#x0a;Plain edits the basics and keeps everything else exactly as it found it."/>
        <TextBlock x:Name="RecentHeading" Text="RECENT" FontSize="11" FontWeight="Bold" Margin="0,28,0,6"
                   Foreground="{DynamicResource Ink3}" Visibility="Collapsed"/>
        <ItemsControl x:Name="RecentList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource Flat}" HorizontalContentAlignment="Left" Height="26"
                      Click="OnOpenRecent" Tag="{Binding Path}" ToolTip="{Binding Path}">
                <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Accent}"/>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Border x:Name="Notes" Grid.Column="1" Width="300" Background="{DynamicResource Surface2}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="14,12,14,10">
            <TextBlock Text="COMMENTS AND TRACKED CHANGES" FontWeight="Bold" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource Accent}"/>
            <TextBlock x:Name="NotesLede" TextWrapping="Wrap" FontSize="11.5" Margin="0,5,0,0"
                       Foreground="{DynamicResource Ink2}"/>
          </StackPanel>
          <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}"/>
          <StackPanel DockPanel.Dock="Bottom" Margin="12,10">
            <Button x:Name="AcceptBtn" Style="{StaticResource Flat}" Content="Accept all tracked changes"
                    HorizontalContentAlignment="Left" Click="OnAcceptChanges"/>
            <Button x:Name="RejectBtn" Style="{StaticResource Flat}" Content="Turn down all tracked changes"
                    HorizontalContentAlignment="Left" Click="OnRejectChanges" Margin="0,2,0,0"/>
            <Button x:Name="ClearNotesBtn" Style="{StaticResource Flat}" Content="Delete all comments"
                    HorizontalContentAlignment="Left" Click="OnRemoveComments" Margin="0,2,0,0"/>
          </StackPanel>
          <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Line}"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="NotesList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,8">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock Text="{Binding When}" DockPanel.Dock="Right" FontSize="10.5" Margin="8,0,0,0"
                                   Foreground="{DynamicResource Ink3}"/>
                        <TextBlock Text="{Binding Who}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                      <TextBlock Text="{Binding What}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                 Foreground="{DynamicResource Ink2}"/>
                      <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding Actions}">
                        <Button Style="{StaticResource Flat}" Content="{Binding KeepLabel}" Height="22" FontSize="11.5"
                                Padding="7,0" Click="OnSettleOne" Tag="{Binding Id}"/>
                        <Button Style="{StaticResource Flat}" Content="{Binding DropLabel}" Height="22" FontSize="11.5"
                                Padding="7,0" Margin="4,0,0,0" Click="OnDropOne" Tag="{Binding Id}"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border x:Name="Pictures" Grid.Column="1" Width="300" Background="{DynamicResource Surface2}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="14,12,14,10">
            <TextBlock Text="PICTURES IN THIS FILE" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Accent}"/>
            <TextBlock x:Name="PicturesLede" TextWrapping="Wrap" FontSize="11.5" Margin="0,5,0,0"
                       Foreground="{DynamicResource Ink2}"/>
          </StackPanel>
          <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}"/>
          <Button x:Name="SavePicturesBtn" DockPanel.Dock="Bottom" Style="{StaticResource Flat}" Margin="12,10"
                  Content="Save them all to a folder" HorizontalContentAlignment="Left" Click="OnSavePictures"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PictureList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,10">
                    <StackPanel>
                      <Image Source="{Binding Preview}" MaxHeight="150" Stretch="Uniform"
                             HorizontalAlignment="Left" Margin="0,0,0,6"/>
                      <DockPanel>
                        <TextBlock Text="{Binding Size}" DockPanel.Dock="Right" FontSize="10.5" Margin="8,0,0,0"
                                   FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Ink3}"/>
                        <TextBlock Text="{Binding Kind}" FontSize="11.5" Foreground="{DynamicResource Ink}"/>
                      </DockPanel>
                      <TextBlock Text="{Binding Part}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                                 TextWrapping="Wrap" Foreground="{DynamicResource Ink3}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border x:Name="Rail" Grid.Column="2" Width="278" Background="{DynamicResource Surface2}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="14,12,14,10">
            <TextBlock Text="PRESERVED" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Preserved}"/>
            <TextBlock Text="In this file but not shown. Written back byte for byte when you save."
                       TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Ink2}" Margin="0,5,0,0"/>
          </StackPanel>
          <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}"/>
          <TextBlock x:Name="RailFoot" DockPanel.Dock="Bottom" Margin="14,10" TextWrapping="Wrap"
                     FontSize="11" Foreground="{DynamicResource Ink2}"/>
          <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Line}"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="RailList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,8">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock Text="{Binding Size}" DockPanel.Dock="Right" FontSize="10.5" Margin="8,0,0,0"
                                   FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Ink3}"/>
                        <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Ink}"/>
                      </DockPanel>
                      <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                                 TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource Ink3}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- find -->
    <Border x:Name="FindBar" Grid.Row="4" Background="{DynamicResource Surface}" Visibility="Collapsed"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10,6">
      <DockPanel LastChildFill="False">
        <TextBlock Text="Find" DockPanel.Dock="Left" VerticalAlignment="Center"
                   Foreground="{DynamicResource Ink2}" FontSize="12" Margin="0,0,10,0"/>
        <Border DockPanel.Dock="Left" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="4"
                Background="{DynamicResource Surface2}" Width="280" Padding="7,0">
          <TextBox x:Name="FindBox" BorderThickness="0" Background="Transparent" Height="24"
                   VerticalContentAlignment="Center" Foreground="{DynamicResource Ink}"
                   TextChanged="OnFindChanged" KeyDown="OnFindKey"/>
        </Border>
        <Button x:Name="FindPrev" Style="{StaticResource Flat}" Content="Previous" Click="OnFindPrevious"
                DockPanel.Dock="Left" Margin="6,0,0,0"/>
        <Button x:Name="FindNext" Style="{StaticResource Flat}" Content="Next" Click="OnFindNext"
                DockPanel.Dock="Left" Margin="2,0,0,0"/>
        <TextBlock Text="Replace with" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,10,0"
                   Foreground="{DynamicResource Ink2}" FontSize="12"/>
        <Border DockPanel.Dock="Left" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="4"
                Background="{DynamicResource Surface2}" Width="220" Padding="7,0">
          <TextBox x:Name="ReplaceBox" BorderThickness="0" Background="Transparent" Height="24"
                   VerticalContentAlignment="Center" Foreground="{DynamicResource Ink}" KeyDown="OnFindKey"/>
        </Border>
        <Button x:Name="ReplaceAllBtn" Style="{StaticResource Flat}" Content="Replace all" Click="OnReplaceAll"
                DockPanel.Dock="Left" Margin="6,0,0,0"/>
        <CheckBox x:Name="MatchCase" Content="Match case" DockPanel.Dock="Left" VerticalAlignment="Center"
                  Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource Ink2}" Click="OnFindOptionChanged"/>
        <TextBlock x:Name="FindCount" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                   Foreground="{DynamicResource Ink3}" FontSize="12"/>
        <Button Style="{StaticResource Flat}" Content="Close" Click="OnFindClose" DockPanel.Dock="Right"/>
      </DockPanel>
    </Border>

    <!-- the promise, as a count -->
    <Border Grid.Row="5" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,0">
      <DockPanel Height="28" LastChildFill="False">
        <Ellipse Width="7" Height="7" Fill="{DynamicResource Preserved}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusPromise" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                   FontSize="11.5" Foreground="{DynamicResource Ink2}"/>
        <TextBlock x:Name="StatusStat" DockPanel.Dock="Right" VerticalAlignment="Center"
                   FontSize="11.5" Foreground="{DynamicResource Ink2}"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
