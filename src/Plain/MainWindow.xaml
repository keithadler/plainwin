<Window x:Class="Plain.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plain" Height="720" Width="1180" MinHeight="420" MinWidth="720"
        Background="{DynamicResource Chrome}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- open files -->
    <Border Grid.Row="0" Background="{DynamicResource Chrome}" Padding="8,4,8,0">
      <ItemsControl x:Name="Tabs">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </Border>

    <!-- one command row -->
    <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="8,5">
      <DockPanel LastChildFill="False">
        <Button x:Name="OpenBtn" Style="{StaticResource Flat}" Content="Open" Click="OnOpen" DockPanel.Dock="Left"/>
        <Button x:Name="SaveBtn" Style="{StaticResource Flat}" Content="Save" Click="OnSave" DockPanel.Dock="Left" Margin="2,0,0,0"/>
        <Button x:Name="UndoBtn" Style="{StaticResource Flat}" Content="Undo" Click="OnUndo" DockPanel.Dock="Left" Margin="2,0,0,0"/>
        <Border x:Name="Sep1" Width="1" Background="{DynamicResource Line}" Height="18" Margin="8,0" DockPanel.Dock="Left"/>
        <TextBlock x:Name="ContextHint" DockPanel.Dock="Left" VerticalAlignment="Center"
                   Foreground="{DynamicResource Ink3}" FontSize="12"/>
        <Button x:Name="KeepBtn" Style="{StaticResource Flat}" Click="OnToggleRail" DockPanel.Dock="Right"
                Background="{DynamicResource PreservedSoft}" BorderBrush="{DynamicResource PreservedLine}"
                Foreground="{DynamicResource Preserved}" FontWeight="SemiBold" Content="Preserved"/>
      </DockPanel>
    </Border>

    <!-- formula bar, spreadsheets only -->
    <Border x:Name="FormulaBar" Grid.Row="2" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Visibility="Collapsed">
      <Grid Height="30">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="96"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="CellRefText" Grid.Column="0" VerticalAlignment="Center" Margin="10,0"
                   FontFamily="Cascadia Mono, Consolas" FontSize="12.5"/>
        <Border Grid.Column="1" Width="1" Background="{DynamicResource Line}"/>
        <TextBox x:Name="CellEditor" Grid.Column="2" VerticalAlignment="Center" Margin="10,0" Padding="0,3"
                 FontFamily="Cascadia Mono, Consolas" FontSize="12.5" BorderThickness="0"
                 Background="Transparent" Foreground="{DynamicResource Ink}"
                 KeyDown="OnFormulaKey" LostFocus="OnFormulaCommit"/>
      </Grid>
    </Border>

    <!-- the file, and the list of what Plain is keeping -->
    <Grid Grid.Row="3" Background="{DynamicResource Surface}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <ContentControl x:Name="Stage" Grid.Column="0"/>

      <TextBlock x:Name="Welcome" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextAlignment="Center" Foreground="{DynamicResource Ink3}" FontSize="14" LineHeight="24"
                 Text="Open a Word, Excel or PowerPoint file, or drop one here.&#x0a;Plain edits the basics and keeps everything else exactly as it found it."/>

      <Border x:Name="Rail" Grid.Column="1" Width="278" Background="{DynamicResource Surface2}"
              BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="14,12,14,10">
            <TextBlock Text="PRESERVED" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource Preserved}"/>
            <TextBlock Text="In this file but not shown. Written back byte for byte when you save."
                       TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource Ink2}" Margin="0,5,0,0"/>
          </StackPanel>
          <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}"/>
          <TextBlock x:Name="RailFoot" DockPanel.Dock="Bottom" Margin="14,10" TextWrapping="Wrap"
                     FontSize="11" Foreground="{DynamicResource Ink2}"/>
          <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Line}"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="RailList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,7">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                 TextWrapping="Wrap" Foreground="{DynamicResource Ink}"/>
                      <DockPanel Margin="0,2,0,0">
                        <TextBlock Text="{Binding Size}" DockPanel.Dock="Right" FontSize="10.5"
                                   FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Ink3}"/>
                        <TextBlock Text="{Binding What}" FontSize="11" Foreground="{DynamicResource Ink2}"
                                   TextTrimming="CharacterEllipsis"/>
                      </DockPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- the promise, as a count -->
    <Border Grid.Row="4" Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,0">
      <DockPanel Height="28" LastChildFill="False">
        <Ellipse Width="7" Height="7" Fill="{DynamicResource Preserved}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusPromise" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0,0,0"
                   FontSize="11.5" Foreground="{DynamicResource Ink2}"/>
        <TextBlock x:Name="StatusStat" DockPanel.Dock="Right" VerticalAlignment="Center"
                   FontSize="11.5" Foreground="{DynamicResource Ink2}"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
