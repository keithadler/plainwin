<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType Condition="'$(CliBuild)' == 'true'">Exe</OutputType>
    <OutputType Condition="'$(CliBuild)' != 'true'">WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF Condition="'$(CliBuild)' != 'true'">true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- One source tree, two programs: the window and the console twin the schedule and scripts use. -->
    <AssemblyName Condition="'$(CliBuild)' == 'true'">plain</AssemblyName>
    <AssemblyName Condition="'$(CliBuild)' != 'true'">Plain for Windows</AssemblyName>
    <RootNamespace>Plain</RootNamespace>
    <DefineConstants Condition="'$(CliBuild)' == 'true'">$(DefineConstants);CLI_BUILD</DefineConstants>

    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-arm64</RuntimeIdentifier>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <InformationalVersion>1.4.0</InformationalVersion>
    <Product>Plain for Windows</Product>
    <Company>Keith Adler</Company>
    <Copyright>Copyright (c) 2026 Keith Adler. MIT licensed.</Copyright>
    <Description>Opens Word, Excel and PowerPoint files, edits the basics, and never damages what it doesn't understand.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Plain.Core/Plain.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(CliBuild)' != 'true'">
    <Resource Include="../../icon/plain-256.png" Link="Assets/plain-256.png" Condition="Exists('../../icon/plain-256.png')" />
  </ItemGroup>

  <!-- The console twin needs none of the window's files. -->
  <ItemGroup Condition="'$(CliBuild)' == 'true'">
    <Compile Remove="MainWindow.xaml.cs" />
    <Compile Remove="SheetView.cs" />
    <Compile Remove="WorkbookView.cs" />
    <Compile Remove="DocView.cs" />
    <Compile Remove="DeckView.cs" />
    <Compile Remove="Screenshots.cs" />
    <!-- the console twin never checks for updates: a scheduled job should not reach the network unasked -->
    <Compile Remove="UpdateCheck.cs" />
    <Compile Remove="Promo.cs" />
    <Compile Remove="Settings.cs" />
    <Compile Remove="Printing.cs" />
    <Compile Remove="Recovery.cs" />
    <Compile Remove="ReadingSettings.xaml.cs" />
    <Compile Remove="App.xaml.cs" />
    <Page Remove="**/*.xaml" />
    <ApplicationDefinition Remove="**/*.xaml" />
  </ItemGroup>

</Project>
